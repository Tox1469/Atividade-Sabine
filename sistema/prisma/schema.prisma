// modelo de dados do sgp, transcrito do dicionario de dados (docs/modelo-de-dados.md, secao 6).
// os nomes das tabelas e colunas sao os mesmos do dicionario, por isso ficaram em snake_case.
// as restricoes check que o prisma nao escreve sozinho estao no final da migracao inicial.

generator client {
  provider = "prisma-client-js"
}

// DIRECT_URL so e usada pelo prisma migrate. no supabase o sistema conecta pelo pooler
// (DATABASE_URL, porta 6543) e a migracao precisa da conexao de sessao (porta 5432).
// no banco local as duas sao iguais
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model usuario {
  id_usuario        Int       @id @default(autoincrement())
  nome              String    @db.VarChar(120)
  email             String    @unique @db.VarChar(150)
  senha_hash        String    @db.VarChar(60)
  perfil            String    @db.VarChar(15)
  ativo             Boolean   @default(true)
  // RNF12: contagem de erros seguidos e ate quando o email fica bloqueado
  tentativas_falhas Int       @default(0) @db.SmallInt
  bloqueado_ate     DateTime?
  ultimo_acesso_em  DateTime?
  criado_em         DateTime  @default(now())

  prestador          prestador?
  cliente            cliente?
  documentos         documento[]
  historicos         historico_situacao[]
  ordens_abertas     ordem_servico[]
  andamentos         andamento_ordem[]
  logs               log_acao[]
}

model prestador {
  id_prestador      Int       @id @default(autoincrement())
  id_usuario        Int?      @unique
  tipo_pessoa       String    @db.Char(1)
  nome_razao_social String    @db.VarChar(150)
  nome_fantasia     String?   @db.VarChar(120)
  cpf_cnpj          String    @unique @db.VarChar(14)
  telefone          String    @db.VarChar(20)
  email             String?   @db.VarChar(150)
  logradouro        String    @db.VarChar(150)
  numero            String    @db.VarChar(10)
  complemento       String?   @db.VarChar(60)
  bairro            String    @db.VarChar(60)
  cidade            String    @db.VarChar(60)
  uf                String    @db.Char(2)
  cep               String    @db.Char(8)
  situacao          String    @default("pendente") @db.VarChar(12)
  criado_em         DateTime  @default(now())
  atualizado_em     DateTime?

  usuario    usuario?              @relation(fields: [id_usuario], references: [id_usuario])
  categorias prestador_categoria[]
  documentos documento[]
  contratos  contrato[]
  historicos historico_situacao[]
  ordens     ordem_servico[]

  @@index([situacao])
}

model cliente {
  id_cliente        Int      @id @default(autoincrement())
  id_usuario        Int?     @unique
  tipo_pessoa       String   @db.Char(1)
  nome_razao_social String   @db.VarChar(150)
  nome_fantasia     String?  @db.VarChar(120)
  cpf_cnpj          String   @unique @db.VarChar(14)
  telefone          String   @db.VarChar(20)
  email             String?  @db.VarChar(150)
  logradouro        String   @db.VarChar(150)
  numero            String   @db.VarChar(10)
  complemento       String?  @db.VarChar(60)
  bairro            String   @db.VarChar(60)
  cidade            String   @db.VarChar(60)
  uf                String   @db.Char(2)
  cep               String   @db.Char(8)
  ativo             Boolean  @default(true)
  criado_em         DateTime @default(now())

  usuario usuario?        @relation(fields: [id_usuario], references: [id_usuario])
  ordens  ordem_servico[]
}

model categoria_servico {
  id_categoria Int     @id @default(autoincrement())
  nome         String  @unique @db.VarChar(60)
  descricao    String? @db.VarChar(255)
  ativa        Boolean @default(true)

  servicos    servico[]
  prestadores prestador_categoria[]
}

model servico {
  id_servico        Int      @id @default(autoincrement())
  id_categoria      Int
  nome              String   @db.VarChar(120)
  descricao         String?  @db.Text
  valor_referencia  Decimal? @db.Decimal(10, 2)
  prazo_padrao_dias Int      @db.SmallInt
  ativo             Boolean  @default(true)

  categoria categoria_servico @relation(fields: [id_categoria], references: [id_categoria])
  ordens    ordem_servico[]
}

model prestador_categoria {
  id_prestador  Int
  id_categoria  Int
  habilitado_em DateTime @db.Date
  ativa         Boolean  @default(true)

  prestador prestador         @relation(fields: [id_prestador], references: [id_prestador])
  categoria categoria_servico @relation(fields: [id_categoria], references: [id_categoria])

  @@id([id_prestador, id_categoria])
}

model tipo_documento {
  id_tipo_documento Int     @id @default(autoincrement())
  nome              String  @unique @db.VarChar(60)
  obrigatorio       Boolean
  exige_validade    Boolean
  ativo             Boolean @default(true)

  documentos documento[]
}

model documento {
  id_documento      Int       @id @default(autoincrement())
  id_prestador      Int
  id_tipo_documento Int
  nome_arquivo      String    @db.VarChar(255)
  arquivo_url       String    @db.VarChar(500)
  tamanho_bytes     Int
  data_emissao      DateTime  @db.Date
  data_validade     DateTime? @db.Date
  versao_atual      Boolean   @default(true)
  enviado_por       Int
  enviado_em        DateTime  @default(now())

  prestador prestador      @relation(fields: [id_prestador], references: [id_prestador])
  tipo      tipo_documento @relation(fields: [id_tipo_documento], references: [id_tipo_documento])
  usuario   usuario        @relation(fields: [enviado_por], references: [id_usuario])

  @@index([data_validade, versao_atual])
}

model contrato {
  id_contrato  Int      @id @default(autoincrement())
  id_prestador Int
  numero       String   @db.VarChar(30)
  data_inicio  DateTime @db.Date
  data_fim     DateTime @db.Date
  valor        Decimal? @db.Decimal(12, 2)
  arquivo_url  String   @db.VarChar(500)
  criado_em    DateTime @default(now())

  prestador prestador @relation(fields: [id_prestador], references: [id_prestador])
}

model historico_situacao {
  id_historico      Int      @id @default(autoincrement())
  id_prestador      Int
  situacao_anterior String?  @db.VarChar(12)
  situacao_nova     String   @db.VarChar(12)
  motivo            String   @db.VarChar(255)
  id_usuario        Int?
  alterado_em       DateTime @default(now())

  prestador prestador @relation(fields: [id_prestador], references: [id_prestador])
  usuario   usuario?  @relation(fields: [id_usuario], references: [id_usuario])
}

model ordem_servico {
  id_ordem             Int       @id @default(autoincrement())
  numero               String    @unique @db.VarChar(20)
  id_cliente           Int
  id_servico           Int
  id_prestador         Int?
  descricao            String    @db.Text
  local_atendimento    String?   @db.VarChar(200)
  prioridade           String    @default("normal") @db.VarChar(10)
  prazo                DateTime  @db.Date
  status               String    @default("aberta") @db.VarChar(12)
  aberta_por           Int
  data_abertura        DateTime  @default(now())
  data_atribuicao      DateTime?
  data_inicio_execucao DateTime?
  data_conclusao       DateTime?
  relato_conclusao     String?   @db.Text
  motivo_cancelamento  String?   @db.VarChar(255)
  entregue_no_prazo    Boolean?

  cliente    cliente           @relation(fields: [id_cliente], references: [id_cliente])
  servico    servico           @relation(fields: [id_servico], references: [id_servico])
  prestador  prestador?        @relation(fields: [id_prestador], references: [id_prestador])
  usuario    usuario           @relation(fields: [aberta_por], references: [id_usuario])
  andamentos andamento_ordem[]
  avaliacao  avaliacao?

  @@index([status, prazo])
  @@index([id_prestador])
  @@index([id_cliente])
}

model andamento_ordem {
  id_andamento    Int      @id @default(autoincrement())
  id_ordem        Int
  status_anterior String?  @db.VarChar(12)
  status_novo     String   @db.VarChar(12)
  observacao      String?  @db.Text
  id_usuario      Int
  registrado_em   DateTime @default(now())

  ordem   ordem_servico @relation(fields: [id_ordem], references: [id_ordem])
  usuario usuario       @relation(fields: [id_usuario], references: [id_usuario])
}

model avaliacao {
  id_avaliacao Int      @id @default(autoincrement())
  id_ordem     Int      @unique
  nota         Int      @db.SmallInt
  comentario   String?  @db.VarChar(500)
  avaliado_em  DateTime @default(now())

  ordem ordem_servico @relation(fields: [id_ordem], references: [id_ordem])

  @@index([avaliado_em])
}

// RF19: sem chave estrangeira em entidade_id de proposito, o log sobrevive ao registro de origem
model log_acao {
  id_log        Int      @id @default(autoincrement())
  id_usuario    Int
  acao          String   @db.VarChar(40)
  entidade      String   @db.VarChar(40)
  entidade_id   Int
  detalhe       String?  @db.Text
  registrado_em DateTime @default(now())

  usuario usuario @relation(fields: [id_usuario], references: [id_usuario])

  @@index([registrado_em, entidade])
}
