#!/bin/sh
# o historico do repositorio mostra so os dois integrantes (RNF11: commits identificaveis por integrante).
# tira da mensagem as linhas de co-autoria e as que alguns editores colocam sozinhos no fim.
# fica ligado sozinho depois do npm install na pasta sistema (script prepare do package.json)
sed -i -E '/^[[:space:]]*(co-authored-by|[a-z]+-session):/Id; /generated with|\/code\/session_/Id' "$1"
